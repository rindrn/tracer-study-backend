                  "console.log('jurusan yang terkirim: ' + JSON.stringify(jurusan));",
                  "pm.test('parameter jurusan milik unit lain diabaikan', () => {",
                  "  jurusan.forEach(j => pm.expect(j).to.eql(milik));",
                  "});"
                ]
              }
            }
