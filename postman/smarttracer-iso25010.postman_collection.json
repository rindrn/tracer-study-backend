    {
      "name": "05 - Reliability",
      "item": [
        {
          "name": "Ketiadaan kesalahan: id non-numerik dijawab 404, bukan 500",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alumni/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alumni",
                "abc"
              ]
            },
            "description": "Bentuk masukan yang tidak mungkin dihasilkan antarmuka. Sebelum pembatasan pola parameter, masukan seperti ini memicu kesalahan tipe yang diteruskan sebagai galat server."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tidak jatuh ke galat server', () => pm.expect(pm.response.code).to.be.below(500));",
                  "pm.test('dijawab 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Toleransi: pelanggaran relasi dijawab 409, bukan 500",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/provinces/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "provinces",
                "1"
              ]
            },
            "description": "Baris ini masih dirujuk tabel upah minimum provinsi. Yang dibuktikan adalah pengecualian basis data ditangkap dan diterjemahkan, bukan diteruskan mentah."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tidak jatuh ke galat server', () => pm.expect(pm.response.code).to.be.below(500));",
                  "pm.test('dijawab 409 Conflict', () => pm.response.to.have.status(409));",
                  "const b = pm.response.json();",
                  "pm.test('pesannya menjelaskan, bukan jejak tumpukan', () => {",
                  "  pm.expect(b.message).to.be.a('string');",
                  "  pm.expect(b.message).to.not.include('SQLSTATE');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Toleransi: rujukan tidak ditemukan dijawab 4xx, bukan 500",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stakeholder-contacts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stakeholder-contacts"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alumni_id\": 999999999,\n  \"questionnaire_id\": 999999999,\n  \"contact_type\": \"atasan\",\n  \"contact_name\": \"Uji Rujukan\",\n  \"contact_email\": \"uji@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tidak jatuh ke galat server', () => pm.expect(pm.response.code).to.be.below(500));",
                  "pm.test('dijawab 4xx', () => pm.expect(pm.response.code).to.be.within(400, 499));",
                  "pm.test('pesannya tidak membocorkan SQL', () =>",
                  "  pm.expect(pm.response.text()).to.not.include('SQLSTATE'));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
