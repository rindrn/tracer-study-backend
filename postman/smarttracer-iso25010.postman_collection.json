    {
      "name": "02 - Functional Suitability",
      "item": [
        {
          "name": "Kelengkapan: daftar alumni terbaca",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/alumni?per_page=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alumni"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "5"
                }
              ]
            },
            "description": "Membuktikan bentuk tanggapan sukses seragam: success dan data selalu ada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('berhasil', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('amplop tanggapan seragam', () => {",
                  "  pm.expect(b).to.have.property('success', true);",
                  "  pm.expect(b).to.have.property('data');",
                  "});",
                  "pm.test('data berisi baris', () => pm.expect(b.data.data.length).to.be.above(0));",
                  "// Field message bersifat opsional pada tanggapan sukses: dari 102 tanggapan",
                  "// 2xx berformat JSON pada koleksi utama, seluruhnya membawa success, tetapi",
                  "// hanya 13 yang membawa message. Dicatat sebagai ketidakseragaman kecil,",
                  "// bukan dijadikan syarat lulus.",
                  "console.log('membawa message: ' + Object.prototype.hasOwnProperty.call(b, 'message'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Kesesuaian: masukan tak lengkap ditolak 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
