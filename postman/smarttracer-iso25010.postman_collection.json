              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stakeholder-contacts/export",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stakeholder-contacts",
                "export"
              ]
            },
            "description": "Nama kontak berasal dari isian bebas alumni. Bila ditulis apa adanya, nilai berawalan = + @ akan dieksekusi aplikasi lembar sebar saat berkasnya dibuka petugas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('berhasil', () => pm.response.to.have.status(200));",
                  "const teks = pm.response.text();",
                  "const sel = teks.split(/\\r?\\n/).slice(1).flatMap(b => b.split(','));",
                  "const berbahaya = sel.filter(s => /^\"?[=+@]/.test(s.trim()));",
                  "console.log('sel berawalan formula tanpa penetralan: ' + berbahaya.length);",
                  "pm.test('muatan yang barusan disisipkan ikut terekspor', () =>",
                  "  pm.expect(teks).to.include('/C calc'));",
                  "pm.test('tidak ada sel yang dimulai formula mentah', () =>",
                  "  pm.expect(berbahaya.length).to.eql(0));"
                ]
              }
            }
          ],
          "response": []
        },
