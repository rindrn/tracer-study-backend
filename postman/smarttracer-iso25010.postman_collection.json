                "type": "text/javascript",
                "exec": [
                  "pm.test('ditolak dengan 422', () => pm.response.to.have.status(422));",
                  "const b = pm.response.json();",
                  "pm.test('memuat rincian kesalahan per field', () => {",
                  "  pm.expect(b).to.have.property('errors');",
