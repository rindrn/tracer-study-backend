APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Zona waktu institusi: Asia/Jakarta (WIB), Asia/Makassar (WITA), Asia/Jayapura (WIT)
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=oltp
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=tracer_study
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# PostgreSQL single database, two schemas
OLTP_DB_HOST=127.0.0.1
OLTP_DB_PORT=5432
OLTP_DB_DATABASE=tracer_study
OLTP_DB_USERNAME=postgres
OLTP_DB_PASSWORD=

OLAP_DB_HOST=127.0.0.1
OLAP_DB_PORT=5432
OLAP_DB_DATABASE=tracer_study
OLAP_DB_USERNAME=postgres
OLAP_DB_PASSWORD=


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# --- Identitas institusi ---------------------------------------------------
# SmartTracer dipasang satu kali untuk satu perguruan tinggi. Nilai di bawah
# ini yang masuk ke dim_prodi.nama_pt di data warehouse dan menjadi kode PT
# bawaan saat impor alumni. Cerminan VITE_INSTITUTION_* di fe-tracer-study.
#
# Isian contoh memakai POLBAN karena data demo di repositori ini memang
# berasal dari sana. Ganti seluruhnya saat dipasang di PT lain.
INSTITUTION_NAME="Politeknik Negeri Bandung"
INSTITUTION_CODE="044015"

# --- Perlindungan data pribadi (UU 27/2022) --------------------------------
# Versi pemberitahuan privasi yang sedang berlaku. Naikkan nilainya setiap
# kali isi pemberitahuan berubah secara material: alumni yang menyetujui
# versi lama akan diminta menyetujui ulang sebelum bisa mengisi kuesioner.
PRIVACY_NOTICE_VERSION="2026.1"

# Berapa lama data pribadi alumni disimpan setelah tahun kelulusan, dalam
# tahun. Dipakai halaman "Data Saya" untuk memberi tahu alumni batas
# penyimpanannya, sesuai asas pembatasan penyimpanan UU 27/2022.
PERSONAL_DATA_RETENTION_YEARS=10
