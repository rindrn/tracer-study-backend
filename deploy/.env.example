# ---------------------------------------------------------------------------
# Salin menjadi deploy/.env lalu isi nilainya. JANGAN commit deploy/.env.
#
# Membuat nilai acak:
#   APP_KEY           -> docker compose run --rm app php artisan key:generate --show
#   CUBEJS_API_SECRET -> openssl rand -hex 32
#   POSTGRES_PASSWORD -> openssl rand -base64 24
# ---------------------------------------------------------------------------

# --- Aplikasi --------------------------------------------------------------
# Alamat publik lengkap, dipakai Laravel untuk menyusun URL absolut.
APP_URL=https://smarttracer.example.id
APP_KEY=

# --- Basis data ------------------------------------------------------------
# Satu database berisi tiga schema: tracer_oltp (transaksional), public (star
# schema OLAP), dan dev_pre_aggregations (pra-agregasi Cube). Yang pertama dan
# ketiga dibuat entrypoint backend saat container app naik; isi schema public
# datang dari seeder, sekali di awal -- lihat bagian Bootstrap di README.
POSTGRES_DB=tracer_study
POSTGRES_USER=smarttracer
POSTGRES_PASSWORD=

# --- Cube ------------------------------------------------------------------
# Nilai yang sama dipakai dua pihak: Cube memverifikasi JWT dengannya, Laravel
# menandatangani token dengannya. Kalau berbeda, semua endpoint analitik
# balas 403 dan gejalanya terlihat seperti dashboard kosong.
CUBEJS_API_SECRET=

# --- Identitas institusi (backend) -----------------------------------------
INSTITUTION_NAME=Perguruan Tinggi
INSTITUTION_CODE=044015
PRIVACY_NOTICE_VERSION=2026.1
PERSONAL_DATA_RETENTION_YEARS=10

# --- Identitas institusi (frontend) ----------------------------------------
# Nilai ini dibaca saat BUILD image FE. Mengubahnya menuntut build ulang:
#   docker compose build fe && docker compose up -d fe
VITE_INSTITUTION_NAME=Perguruan Tinggi
VITE_INSTITUTION_SHORT_NAME=Perguruan Tinggi
VITE_INSTITUTION_DOMAIN=perguruantinggi.ac.id
VITE_INSTITUTION_APP_DOMAIN=smarttracer.example.id
VITE_INSTITUTION_EMAIL=
VITE_INSTITUTION_PHONE=
VITE_INSTITUTION_ADDRESS=
VITE_INSTITUTION_UNIT=
